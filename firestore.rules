rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidExpedition(data) {
      return data.keys().hasAll(['id', 'name', 'status', 'lat', 'lng']) &&
             data.keys().size() == 5 &&
             data.id is string &&
             data.name is string &&
             data.status in ['active', 'planned', 'completed'] &&
             data.lat is number &&
             data.lng is number;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'lat', 'lng', 'alt', 'status']) &&
             data.id is string &&
             data.name is string &&
             data.lat is number &&
             data.lng is number &&
             data.alt is number &&
             data.status in ['active', 'resting', 'stationary', 'emergency'];
    }

    // 4. Collection Matchers
    match /expeditions/{expeditionId} {
      allow read: if true; // Public view for expeditions
      allow write: if isSignedIn(); // Only authenticated users can manage expeditions

      match /members/{memberId} {
        allow read: if true; // Public view for live tracking
        allow write: if isSignedIn(); // Only authenticated members/base camp can update telemetry
      }

      match /alerts/{alertId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
