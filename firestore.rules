rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // 3. Entity Validations
    function isValidExpedition(data) {
      let requiredFields = ['id', 'name', 'status', 'lat', 'lng'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.name is string &&
             data.status in ['active', 'planned', 'completed'] &&
             data.lat is number &&
             data.lng is number;
    }

    function isValidMember(data) {
      let requiredFields = ['id', 'name', 'lat', 'lng', 'alt', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.name is string &&
             data.lat is number &&
             data.lng is number &&
             data.alt is number &&
             data.status in ['active', 'resting', 'stationary', 'emergency'];
    }

    function isValidAlert(data) {
      let requiredFields = ['id', 'userId', 'lat', 'lng', 'type', 'timestamp'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.lat is number &&
             data.lng is number &&
             data.type in ['HELI_EVAC', 'MEDICAL', 'LOGISTICS'] &&
             data.timestamp is timestamp;
    }

    // 4. Collection Matchers
    match /expeditions/{expeditionId} {
      allow read: if true; // Public view for expeditions
      allow create, update: if isSignedIn() && isValidExpedition(incoming());
      allow delete: if false; // Prevention of accidental deletion

      match /members/{memberId} {
        allow read: if true; // Public view for live tracking
        // Only the member themselves can update their telemetry
        allow write: if isOwner(memberId) && isValidMember(incoming());
      }

      match /alerts/{alertId} {
        allow read: if true;
        // Any signed in user can create an alert for an expedition they are part of
        // We validate that the userId in the alert matches the auth.uid
        allow create: if isSignedIn() && isValidAlert(incoming());
        allow update, delete: if false; // Alerts are permanent records
      }
    }
  }
}
